# Cloudflare Pages response headers (this file itself is not published).
# Pages serves everything from Cloudflare's edge cache; these only tune browsers.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Data changes at most daily: let browsers reuse it for 10 minutes, then revalidate.
/data/*
  Cache-Control: public, max-age=600, must-revalidate

# Scripts and styles change with the site: browsers recheck them on every load (a cheap
# "not modified" when unchanged), so a deploy never leaves visitors running old code.
# Needs Cloudflare dashboard > Caching > Configuration > Browser Cache TTL set to
# "Respect Existing Headers"; otherwise Cloudflare raises this to its 4-hour default. Until
# then, bump the ?v= on the asset links in index.html whenever a script or style changes.
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/style.css
  Cache-Control: public, max-age=0, must-revalidate
